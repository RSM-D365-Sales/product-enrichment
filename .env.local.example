# Dev-only credentials for the D365 ERP MCP token helper (vite.config.ts).
# Copy this file to `.env.local` (gitignored) and fill in your values.
# NEVER commit the real secret — .env.local is excluded via .gitignore (*.local).

# Entra tenant (Directory ID) that hosts the app registration and the F&O environment
D365_TENANT_ID=00000000-0000-0000-0000-000000000000

# App registration (Application/client ID) — must also be added in F&O on the
# "Allowed MCP clients" page AND mapped to a service user in
# System administration > Setup > Microsoft Entra ID applications
D365_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret VALUE from the app registration (Certificates & secrets)
D365_CLIENT_SECRET=your-secret-value

# F&O environment base URL (the token audience)
D365_RESOURCE=https://your-environment.operations.dynamics.com
